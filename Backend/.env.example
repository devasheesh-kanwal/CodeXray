# CodeXray backend settings. Copy to .env (in Backend/ or the repo root) and fill in.
# Backend/.env overrides the repo-root .env. Never commit .env.

# --- App ---
# true: every endpoint returns fixture data from app/mocks/ (no LLM, no indexing)
MOCK_MODE=true
# true: LLM answers and embeddings come only from the on-disk caches; no API calls
DEMO_MODE=false
# Repo that scripts/demo_prepare.py indexes and caches answers for (default: tests/fixtures/sample_repo)
# DEMO_REPO_PATH=C:/code/my-demo-repo
# REQUIRED. The one origin allowed by CORS (the frontend URL). "*" is rejected.
FRONTEND_ORIGIN=http://localhost:5173
# Indexes, caches, runs, worktrees. Relative paths are under Backend/.
DATA_DIR=data

# --- Indexing ---
# The ONE embedding model (Gemini API). Changing it means re-indexing every repo.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# false = keyword (BM25) search only, no embedding API calls
EMBEDDINGS=true
# true = one-line LLM summary per file while indexing (uses the fast_small lane)
FILE_SUMMARIES=false

# --- Q&A ---
# Below the best search score threshold the answer is "No relevant code found"
# and the Explainer is not called. The score scale differs per search mode:
# hybrid (Gemini vectors): unrelated questions score ~0.6, relevant ones ~0.75
NOT_FOUND_THRESHOLD=0.68
# bm25_only: share of the query's words found in the best chunk
NOT_FOUND_THRESHOLD_BM25=0.5
# Token budget for the code snippets sent to the Explainer
QA_CONTEXT_TOKENS=12000

# --- Repair ---
# Seconds one test run may take in the sandbox before it is killed
REPAIR_TEST_TIMEOUT_S=120
# Docker image for the test sandbox (build it: docker build -t codexray-sandbox sandbox/).
# Without Docker, tests run as a plain subprocess with a timeout (weaker sandbox).
SANDBOX_IMAGE=codexray-sandbox:latest

# --- LLM router ---
# Seconds before an LLM request counts as timed out (then retried once, then next model)
LLM_TIMEOUT_S=30

# Provider keys: comma-separated, several keys per provider allowed.
# Empty = provider disabled. Lanes and models are in app/llm/routes.yaml.
# GEMINI_API_KEYS are also used for embeddings.
NVIDIA_API_KEYS=
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
DEEPSEEK_API_KEYS=

# Not used (kept so older .env files still load): LLM_PROVIDER, LLM_FALLBACK_PROVIDERS, *_MODEL
