{
  "files": {
    "app/__init__.py": [
      "from flask import Flask",
      "",
      "from app.db import close_db, init_db",
      "from app.routes import bp as todos_bp",
      "",
      "",
      "def create_app(config_object=\"config.Config\"):",
      "    \"\"\"Application factory: build and configure the Flask app.\"\"\"",
      "    app = Flask(__name__)",
      "    app.config.from_object(config_object)",
      "",
      "    app.teardown_appcontext(close_db)",
      "    app.register_blueprint(todos_bp, url_prefix=\"/api/todos\")",
      "",
      "    with app.app_context():",
      "        init_db()",
      "    return app"
    ],
    "app/auth.py": [
      "from functools import wraps",
      "",
      "from flask import abort, current_app, g, request",
      "",
      "",
      "def verify_token(token):",
      "    \"\"\"Return the user name for a valid API token, else None.\"\"\"",
      "    tokens = current_app.config[\"API_TOKENS\"]",
      "    return tokens.get(token)",
      "",
      "",
      "def login_required(view):",
      "    \"\"\"Reject requests without a valid 'Authorization: Bearer <token>' header.\"\"\"",
      "",
      "    @wraps(view)",
      "    def wrapped(*args, **kwargs):",
      "        header = request.headers.get(\"Authorization\", \"\")",
      "        token = header.removeprefix(\"Bearer \").strip()",
      "        user = verify_token(token)",
      "        if user is None:",
      "            abort(401)",
      "        g.user = user",
      "        return view(*args, **kwargs)",
      "",
      "    return wrapped"
    ],
    "app/db.py": [
      "import sqlite3",
      "",
      "from flask import current_app, g",
      "",
      "",
      "def get_db():",
      "    \"\"\"Return the request-scoped SQLite connection, opening it if needed.\"\"\"",
      "    if \"db\" not in g:",
      "        g.db = sqlite3.connect(current_app.config[\"DATABASE\"])",
      "        g.db.row_factory = sqlite3.Row",
      "    return g.db",
      "",
      "",
      "def close_db(exc=None):",
      "    db = g.pop(\"db\", None)",
      "    if db is not None:",
      "        db.close()",
      "",
      "",
      "def init_db():",
      "    db = get_db()",
      "    db.execute(",
      "        \"CREATE TABLE IF NOT EXISTS todos (\"",
      "        \"id INTEGER PRIMARY KEY AUTOINCREMENT, \"",
      "        \"title TEXT NOT NULL, \"",
      "        \"done INTEGER NOT NULL DEFAULT 0, \"",
      "        \"owner TEXT NOT NULL)\"",
      "    )",
      "    db.commit()"
    ],
    "app/models.py": [
      "from dataclasses import dataclass",
      "",
      "",
      "@dataclass",
      "class Todo:",
      "    id: int",
      "    title: str",
      "    done: bool",
      "    owner: str",
      "",
      "    @classmethod",
      "    def from_row(cls, row):",
      "        return cls(row[\"id\"], row[\"title\"], bool(row[\"done\"]), row[\"owner\"])",
      "",
      "    def to_dict(self):",
      "        return {\"id\": self.id, \"title\": self.title, \"done\": self.done}"
    ],
    "app/routes.py": [
      "from flask import Blueprint, abort, g, jsonify, request",
      "",
      "from app.auth import login_required",
      "from app.db import get_db",
      "from app.models import Todo",
      "",
      "bp = Blueprint(\"todos\", __name__)",
      "",
      "",
      "@bp.get(\"/\")",
      "@login_required",
      "def list_todos():",
      "    rows = get_db().execute(",
      "        \"SELECT * FROM todos WHERE owner = ?\", (g.user,)",
      "    ).fetchall()",
      "    return jsonify([Todo.from_row(row).to_dict() for row in rows])",
      "",
      "",
      "@bp.post(\"/\")",
      "@login_required",
      "def create_todo():",
      "    data = request.get_json(silent=True) or {}",
      "    title = (data.get(\"title\") or \"\").strip()",
      "    if not title:",
      "        abort(400, description=\"title is required\")",
      "    db = get_db()",
      "    cur = db.execute(",
      "        \"INSERT INTO todos (title, owner) VALUES (?, ?)\", (title, g.user)",
      "    )",
      "    db.commit()",
      "    return jsonify({\"id\": cur.lastrowid, \"title\": title, \"done\": False}), 201",
      "",
      "",
      "@bp.delete(\"/<int:todo_id>\")",
      "@login_required",
      "def delete_todo(todo_id):",
      "    db = get_db()",
      "    row = db.execute(",
      "        \"SELECT * FROM todos WHERE id = ? AND owner = ?\", (todo_id, g.user)",
      "    ).fetchone()",
      "    todo = Todo.from_row(row)",
      "    db.execute(\"DELETE FROM todos WHERE id = ?\", (todo.id,))",
      "    db.commit()",
      "    return jsonify(todo.to_dict())"
    ],
    "config.py": [
      "import os",
      "",
      "",
      "class Config:",
      "    DATABASE = os.environ.get(\"TODO_DB\", \"todos.sqlite\")",
      "    API_TOKENS = {\"dev-token\": \"alice\"}"
    ],
    "tests/test_routes.py": [
      "from app import create_app",
      "",
      "AUTH = {\"Authorization\": \"Bearer dev-token\"}",
      "",
      "",
      "def make_client(tmp_path):",
      "    class TestConfig:",
      "        DATABASE = str(tmp_path / \"test.sqlite\")",
      "        API_TOKENS = {\"dev-token\": \"alice\"}",
      "",
      "    return create_app(TestConfig).test_client()",
      "",
      "",
      "def test_create_and_list(tmp_path):",
      "    client = make_client(tmp_path)",
      "    client.post(\"/api/todos/\", json={\"title\": \"milk\"}, headers=AUTH)",
      "    resp = client.get(\"/api/todos/\", headers=AUTH)",
      "    assert resp.get_json()[0][\"title\"] == \"milk\"",
      "",
      "",
      "def test_delete_missing_todo_returns_404(tmp_path):",
      "    client = make_client(tmp_path)",
      "    resp = client.delete(\"/api/todos/999\", headers=AUTH)",
      "    assert resp.status_code == 404"
    ]
  }
}
